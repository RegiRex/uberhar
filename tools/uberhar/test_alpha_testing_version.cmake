# CodexAstraLocal: Exercise the actual version parser and generated native/UI decision,
# including retained alpha settings becoming inert in beta/full builds.
if(NOT DEFINED TEST_OUTPUT)
    message(FATAL_ERROR "TEST_OUTPUT is required")
endif()
file(MAKE_DIRECTORY "${TEST_OUTPUT}")
include("${CMAKE_CURRENT_LIST_DIR}/../../CMakeModules/ReadUberharVersion.cmake")
function(check_version version expected)
    file(WRITE "${TEST_OUTPUT}/version" "${version}\n")
    read_uberhar_alpha_version("${TEST_OUTPUT}/version" actual)
    if(NOT "${actual}" STREQUAL "${expected}")
        message(FATAL_ERROR "${version}: got ${actual}, expected ${expected}")
    endif()
    set(UBERHAR_ALPHA_TESTING ${actual})
    configure_file("${CMAKE_CURRENT_LIST_DIR}/../../src/common/scm_rev.cpp.in"
                   "${TEST_OUTPUT}/scm_rev.cpp" @ONLY)
    file(READ "${TEST_OUTPUT}/scm_rev.cpp" generated)
    if(NOT generated MATCHES "const bool g_uberhar_alpha_testing = ${expected};")
        message(FATAL_ERROR "Generated gate disagrees with version parser")
    endif()
endfunction()
check_version("0.1.56" true)
check_version("0.2.0" false)
check_version("1.0.0" false)
check_version("1.2.3" true)
check_version("0.1.000" false)
check_version("0.1.001" true)
check_version("0.1.999999999999999999999999" true)
check_version("0.1" false)
check_version("0.1.0-alpha" false)
check_version("0.1.56extra" false)
check_version("0.1.-1" false)
check_version("" false)
read_uberhar_alpha_version("${TEST_OUTPUT}/missing-version" missing)
if(missing)
    message(FATAL_ERROR "Missing version must not enable Testing")
endif()
message(STATUS "PASS alpha gate: actual parser/generated constant across release versions")
