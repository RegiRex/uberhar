<?xml version="1.0" encoding="utf-8"?>
<!-- CodexAstraLocal: Shared temporary Testing controls for home Options and Settings. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/testing_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:visibility="visible">

        <!-- CodexAstraLocal: Home selects the title whose separate Testing choices are edited. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/testing_target"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/uberhar_testing_global_choices"
            android:visibility="gone" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/testing_enabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/uberhar_testing"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <TextView
            android:id="@+id/testing_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/uberhar_testing_description"
            android:textAppearance="?attr/textAppearanceBodySmall" />

        <LinearLayout
            android:id="@+id/testing_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/testing_presets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="16dp"
                    android:text="@string/internal_resolution"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/testing_resolution"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/testing_resolution_2x"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/uberhar_testing_resolution_2x" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/testing_resolution_4x"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/uberhar_testing_resolution_4x" />
                </com.google.android.material.button.MaterialButtonToggleGroup>
            </LinearLayout>
            <!-- CodexAstraLocal: Global defaults and title overrides share the same launch controls. -->
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/testing_disable_right_eye_render"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/disable_right_eye_render" />

            <TextView
                android:id="@+id/testing_right_eye_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/uberhar_testing_right_eye_description"
                android:textAppearance="?attr/textAppearanceBodySmall" />

            <!-- CodexAstraLocal: Testing controls preserve the preset baseline until explicitly selected. -->
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/testing_hardware_shaders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/hw_shaders" />

            <TextView
                android:id="@+id/testing_hardware_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/uberhar_testing_hardware_description"
                android:textAppearance="?attr/textAppearanceBodySmall" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/testing_render_thread_delay"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/delay_render_thread" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/testing_linear_filtering"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/linear_filtering" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/uberhar_testing_linear_description"
                android:textAppearance="?attr/textAppearanceBodySmall" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/uberhar_testing_stereo_depth"
                android:textAppearance="?attr/textAppearanceBodyMedium" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/testing_stereo_depth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/testing_stereo_depth_0"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/uberhar_testing_stereo_depth_0" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/testing_stereo_depth_1"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/uberhar_testing_stereo_depth_1" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/uberhar_testing_stereo_description"
                android:textAppearance="?attr/textAppearanceBodySmall" />
        </LinearLayout>
        <!-- CodexAstraLocal: Title inheritance and driver choices stay available with Testing off. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/testing_use_global"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/uberhar_testing_use_global"
            android:visibility="gone" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/game_driver"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/uberhar_game_driver"
            android:visibility="gone" />
    </LinearLayout>
